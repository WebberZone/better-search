includes:
	- phpstan-baseline.neon
parameters:
    level: 5
    paths:
        - better-search.php
        - uninstaller.php
        - load-freemius.php
        - includes/
    scanFiles:
        - better-search.php
        - uninstaller.php
        - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-commands-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-i18n-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
    scanDirectories:
        - includes/
    bootstrapFiles:
        - phpstan-bootstrap.php
    # Core marks both #[AllowDynamicProperties], and the plugin attaches its own
    # score/blog_id/topscore values to them.
    universalObjectCratesClasses:
        - WP_Post
        - WP_Query
    ignoreErrors:
